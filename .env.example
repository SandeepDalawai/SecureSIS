# SecureSIS – Environment Configuration Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your own values.
#   cp .env.example .env
#
# NEVER commit your actual .env file to version control.
# .env is already listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# Flask secret key — used for session signing.
# Generate a secure value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-randomly-generated-key

# Demo account passwords (used only when the database is first initialised).
# Choose your own values — do NOT use the ones from the assignment report.
DEMO_ADMIN_PASSWORD=replace-with-your-own-admin-password
DEMO_FACULTY_PASSWORD=replace-with-your-own-faculty-password
DEMO_STUDENT_PASSWORD=replace-with-your-own-student-password

# Flask debug mode (set to false for any shared/public environment)
FLASK_DEBUG=false

# Optional: custom database path (default: database/secure_sis.db)
# DATABASE_PATH=database/secure_sis.db
